# ==============================================
# PostgreSQL (banco de dados local via Docker)
# ==============================================
# Obrigatório: credenciais usadas somente pelo PostgreSQL local do Docker.
POSTGRES_USER=taskly
POSTGRES_PASSWORD=troque-por-uma-senha-local-forte
POSTGRES_DB=taskly

# ==============================================
# Autenticação
# ==============================================
# Obrigatório: segredo usado para assinar os tokens JWT da API local.
# Sem essa variável, o Docker Compose recusa iniciar o backend.
# Gere um valor forte com: openssl rand -base64 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ==============================================
# CORS (comunicação entre front-end e back-end)
# ==============================================
# Opcional: aceita múltiplas origens separadas por vírgula.
# "localhost" e "127.0.0.1" são origens diferentes para o navegador.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# ==============================================
# Front-end (Vite)
# ==============================================
# Opcional: URL pública da API incorporada no build do front-end.
# Alterar este valor exige reconstruir a imagem: docker compose build frontend
VITE_API_URL=http://localhost:8080
