# Credenciais usadas somente pelo PostgreSQL local do Docker.
POSTGRES_USER=taskly
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=taskly

# Segredo usado para assinar os tokens JWT da API local.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Origem permitida pelo CORS durante o desenvolvimento do front-end.
FRONTEND_URL=http://localhost:5173

# URL pública consumida pelo front-end compilado no Docker local.
VITE_API_URL=http://localhost:8080
